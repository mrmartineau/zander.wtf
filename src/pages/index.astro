---
import BlockAbout from '~/components/BlockAbout.astro';
import BlockBlog from '~/components/BlockBlog.astro';
import BlockLinks from '~/components/BlockLinks.astro';
import BlockNotes from '~/components/BlockNotes.astro';
import ModeCard from '~/components/ModeCard.astro';
import PromotedProjects from '~/components/PromotedProjects.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE_METADATA } from '../consts';

const slug = 'home';
---

<!-- Each [data-window] section becomes its own window on the desktop. The
     greeting lives in BaseLayout, behind the windows. -->
<BaseLayout
  title={SITE_METADATA[slug].title}
  subtitle={SITE_METADATA[slug].subtitle}
  slug={slug}
>
  <div class="zm-mainContainer zm-home">
    <section id="projects" data-window="Projects">
      <PromotedProjects />
    </section>
    <ModeCard />
    <div class="zm-home-grid1">
      <section id="blog" data-window="Latest posts">
        <BlockBlog />
      </section>
      <section id="about" data-window="About me">
        <BlockAbout />
      </section>
    </div>
    <div class="zm-home-grid2">
      <section id="links" data-window="Latest links">
        <BlockLinks />
      </section>
      <section id="notes" data-window="Latest notes">
        <BlockNotes />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .zm-home {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }

  .zm-home-grid1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);

    @media screen and (min-width: 1150px) {
      /* gap: var(--space-2xl); */
      grid-template-columns: 1fr 1fr;
    }
  }

  .zm-home-grid2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);

    @media screen and (min-width: 950px) {
      /* gap: var(--space-2xl); */
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The promoted grid carries its own big block margin; the grid gap is enough */
  #projects :global(.zm-promoted) {
    margin-block-end: 0;
  }
</style>
