---
import BlockAbout from '~/components/BlockAbout.astro';
import BlockBlog from '~/components/BlockBlog.astro';
import BlockLinks from '~/components/BlockLinks.astro';
import BlockNotes from '~/components/BlockNotes.astro';
import PromotedProjects from '~/components/PromotedProjects.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE_METADATA } from '../consts';

const slug = 'home';
---

<!-- Each [data-window] section becomes its own window on the desktop. The
     greeting lives in BaseLayout, behind the windows. -->
<BaseLayout
  title={SITE_METADATA[slug].title}
  subtitle={SITE_METADATA[slug].subtitle}
  slug={slug}
>
  <div class="zm-mainContainer zm-block-grid">
    <section id="projects" data-window="Projects" data-size="wide">
      <PromotedProjects />
    </section>
    <section id="about" data-window="About me">
      <BlockAbout />
    </section>
    <section id="blog" data-window="Latest posts">
      <BlockBlog />
    </section>
    <section id="links" data-window="Latest links">
      <BlockLinks />
    </section>
    <section id="notes" data-window="Latest notes">
      <BlockNotes />
    </section>
  </div>
</BaseLayout>

<style>
  .zm-block-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
    margin-block-start: var(--space-l);

    @media screen and (min-width: 950px) {
      gap: var(--space-2xl);
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
