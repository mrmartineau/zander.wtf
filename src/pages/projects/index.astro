---
import { getCollection } from 'astro:content';
import { SITE_METADATA } from 'src/consts';
import ProjectCard from '~/components/ProjectCard.astro';
import ContentLayout from '~/layouts/ContentLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.promote) - Number(a.data.promote) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const sections = [
  { type: 'ios-app', label: 'iOS apps' },
  { type: 'app', label: 'Apps' },
  { type: 'package', label: 'Packages' },
  { type: 'extension', label: 'IDE Extensions' },
  { type: 'raycast-extension', label: 'Raycast extensions' },
  { type: 'framework', label: 'Frameworks' },
  { type: 'experiment', label: 'Experiments' },
]
  .map((section) => ({
    ...section,
    projects: projects.filter((project) => project.data.type === section.type),
  }))
  .filter((section) => section.projects.length > 0);

const slug = 'projects';
---

<ContentLayout
  title={SITE_METADATA[slug].title}
  subtitle={SITE_METADATA[slug].subtitle}
  slug={slug}
>
  <nav class="zm-project-nav" aria-label="Jump to a section">
    {
      sections.map(({ type, label, projects }) => (
        <a href={`#${type}`}>
          {label}
          <span class="zm-project-nav__count">{projects.length}</span>
        </a>
      ))
    }
  </nav>

  <div class="zm-project-sections">
    {
      sections.map(({ type, label, projects }) => (
        <section class="zm-project-section" id={type}>
          <h2>{label}</h2>
          <div class="zm-project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</ContentLayout>

<style>
  .zm-project-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-end: var(--space-l);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .zm-project-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: 100px;
    text-decoration: none;
    color: var(--colour-text);

    &:hover,
    &:focus-visible {
      border-color: currentcolor;
      background-color: var(--bg-block);
    }
  }

  .zm-project-nav__count {
    opacity: 0.6;
    font-size: var(--step--2);
  }

  /* The anchor sits on the section, not its heading, so it needs its own
     offset — the h2 rule in typography.css never applies here. */
  .zm-project-section {
    scroll-margin-top: var(--space-m);
  }

  .zm-project-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .zm-project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    margin-block-start: var(--space-s);

    @media screen and (min-width: 550px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
