---
// Public dashboard of the reactions data (astro-d1-reactions). Rendered on
// request like /search, so the numbers are always current. Which pages it
// lists is the `pages` option in astro.config.mjs.
export const prerender = false;

import { Stats as Dashboard } from 'astro-d1-reactions/components';
import { SITE_METADATA } from 'src/consts';
import ContentLayout from '~/layouts/ContentLayout.astro';

const slug = 'stats';
---

<ContentLayout
  title={SITE_METADATA[slug].title}
  subtitle={SITE_METADATA[slug].subtitle}
  slug={slug}
  reactions={{ slug: `/${slug}`, highlights: false }}
>
  <div class="flow">
    <p>
      Every post, note and project here counts its readers and lets them leave
      a heart. Posts and notes also let you highlight the bits you like. This
      is all of it. No cookies and no names: a reader is a random id kept in
      their browser, so each person counts once per page.
    </p>

    <Dashboard locale="en-GB" />
  </div>
</ContentLayout>
