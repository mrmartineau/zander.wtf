---
import { type CollectionEntry, render } from 'astro:content';
import HeadingMinimap from '~/components/HeadingMinimap.astro';
import RelatedLinks from '~/components/RelatedLinks.astro';
import { getBlog } from '~/utils/blog';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getBlog();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout {...post}>
  <Content />
  <HeadingMinimap headings={headings} />
  <RelatedLinks href={`/blog/${post.id}`} />
  <footer class="mt-12 clear-left">
    <span class="mono">&gt;</span> comment on{' '}
    <a
      href={`https://bsky.app/intent/compose?text=Reading%20%20https%3A//zander.wtf/blog/${post.id}%20by%20%40zander.wtf,%0A%0AI%20think...`}
      target="_blank"
    >
      bluesky
    </a>
    <br />
    <span class="mono">&gt;</span>{' '}
    <a href="/blog">cd ..</a>
  </footer>
</BlogPostLayout>

<style lang="postcss">
  .mono {
    font-family: var(--font-mono);
  }
</style>
