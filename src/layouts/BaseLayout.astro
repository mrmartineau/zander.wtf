---
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/duotone';
import '@phosphor-icons/web/fill';
import BaseHead from '~/components/BaseHead.astro';
import Footer from '~/components/Footer.astro';
import Greeting from '~/components/Greeting.astro';
import Header from '~/components/Header.astro';
import Desktop from '~/components/solid/desktop/Desktop';
import Tui from '~/components/solid/tui/Tui';
import { SITE_FOOTER_ITEMS, SITE_NAV_ITEMS } from '../consts';

const { title, subtitle, image, slug } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={subtitle} image={image} slug={slug} />
    <script is:inline>
      // The URL prefix picks the front end. Keep in sync with src/utils/uiMode.ts
      var zmMode = (location.pathname.match(/^\/(desktop|tui|txt)(?=\/|$)/) || [])[1];
      document.documentElement.classList.add(zmMode || 'classic');
      if (zmMode === 'txt') {
        // Plain text: no stylesheets, ever — the browser's own styles only.
        var zmStrip = function (root) {
          root.querySelectorAll('link[rel="stylesheet"], style').forEach(function (el) {
            el.remove();
          });
        };
        zmStrip(document);
        new MutationObserver(function (records) {
          records.forEach(function (r) {
            r.addedNodes.forEach(function (n) {
              if (n.nodeType !== 1) return;
              if (n.matches('link[rel="stylesheet"], style')) n.remove();
              else zmStrip(n);
            });
          });
        }).observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', function () {
          // The greeting belongs to the home page only
          if (document.body.dataset.slug !== 'home') document.getElementById('greeting')?.remove();
          // The big name is a full-width SVG; without CSS it swallows the page
          document.querySelectorAll('.zm-bigname').forEach(function (el) { el.remove(); });
          // Stay in plain text: site links get the prefix
          document.querySelectorAll('a[href^="/"]').forEach(function (a) {
            var href = a.getAttribute('href');
            if (/^\/(desktop|tui|txt)(\/|$)/.test(href) || /\.[a-z0-9]+$/i.test(href.split(/[?#]/)[0])) return;
            a.setAttribute('href', '/txt' + (href === '/' ? '/' : href));
          });
          // The mode card was built for the website; here, plain text is
          // current and the website is a link back
          var plain = location.pathname.replace(/^\/txt(?=\/|$)/, '') || '/';
          document.querySelectorAll('.zm-modes').forEach(function (card) {
            var site = card.querySelector('.zm-mode.is-current');
            var txt = card.querySelector('a.zm-mode[href^="/txt"]');
            var here = card.querySelector('.zm-mode-here');
            if (!site || !txt) return;
            var link = document.createElement('a');
            link.className = 'zm-mode';
            link.href = plain;
            link.innerHTML = site.innerHTML;
            link.querySelector('.zm-mode-here')?.remove();
            site.replaceWith(link);
            var current = document.createElement('div');
            current.className = 'zm-mode is-current';
            current.setAttribute('aria-current', 'true');
            current.innerHTML = txt.innerHTML;
            if (here) current.querySelector('div, span').append(here);
            txt.replaceWith(current);
          });
        });
      }
    </script>
  </head>
  <body data-slug={slug}>
    <noscript>
      <nav class="nojs-nav">
        <a href="/">Home</a>
        {SITE_NAV_ITEMS.map((item) => <a href={item.url}>{item.text}</a>)}
        {SITE_FOOTER_ITEMS.map((item) => <a href={item.url}>{item.text}</a>)}
      </nav>
    </noscript>
    <Header />
    <Greeting />
    <main id="page">
      <slot />
    </main>
    <Footer />
    <Desktop client:only="solid-js" nav={SITE_NAV_ITEMS} more={SITE_FOOTER_ITEMS} />
    <Tui client:only="solid-js" nav={SITE_NAV_ITEMS} more={SITE_FOOTER_ITEMS} />
  </body>
</html>
