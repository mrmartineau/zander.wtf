---
import SearchForm from '~/components/SearchForm.astro';
import ContentLayout from './ContentLayout.astro';

const { title, subtitle, slug } = Astro.props;
---

<ContentLayout title={title} subtitle={subtitle} slug={slug}>
  <div class="note-main">
    <div class="mb-6">
      <SearchForm placeholder="Search notes..." />
    </div>
    <slot />
  </div>
</ContentLayout>

<style>
  .note-main {
    min-width: 0;
    max-width: 1000px;
  }
</style>
