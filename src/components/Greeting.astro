---
// The "Hi! I'm Zander" intro. Rendered on every page; the desktop shell
// adopts it into the desktop background, behind the windows.

// The intro is rendered a letter at a time so each glyph is its own hover
// target. `name` marks the segment that carries the accent styling + avatar;
// `rotates` marks the slot that cycles through ROTATING_WORDS.
const ROTATING_WORDS = [
  'web apps',
  'iOS apps',
  'design systems',
  'npm packages',
  'Raycast extensions',
];

const introSegments = [
  { text: 'Hi! I’m ' },
  { text: 'Zander', name: true },
  { text: ', I make ' },
  { text: ROTATING_WORDS[0], rotates: true },
];

// Read out in full, so the sentence doesn't depend on which word is showing.
const introLabel = `Hi! I’m Zander, I make ${ROTATING_WORDS.join(' and ')}`;

const toLetters = (text: string) => [...text];
---

<!-- prettier-ignore -->
<div id="greeting" class="zm-greeting">
  <h1 class="zm-intro" aria-label={introLabel}>
    {introSegments.map(({ text, name, rotates }) => {
      // Elements stay on one line: `.name` is `white-space: pre`, so any
      // whitespace the template introduces would render as a real space.
      // Each letter is hidden from assistive tech: the h1's aria-label reads
      // the whole sentence, so the per-glyph spans would only be noise.
      const letters = toLetters(text).map((char) =>
        char === ' ' ? ' ' : <span class="letter" aria-hidden="true">{char}</span>
      );

      if (rotates) {
        return <span class="rotator" data-words={JSON.stringify(ROTATING_WORDS)}>{letters}</span>;
      }

      if (name) {
        return <span class="name">{letters}<img src="/images/avatars/zm-avatar-08-2026.webp" class="avatar" width="180" height="180" alt="Stylised (pixellated) picture of Zander" /></span>;
      }

      return letters;
    })}
  </h1>
  <!-- Announces each new word. Polite, so it waits for the reader to pause. -->
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-live></p>
  <button type="button" class="zm-intro-pause" aria-pressed="false" aria-label="Pause the rotating words" hidden>
    <i class="ph-fill ph-pause" aria-hidden="true"></i>
  </button>
</div>

<script>
  // Cycles the intro's rotating word, glitching through Alpha Lyrae's
  // stylistic sets on the way. The word swap happens at the midpoint, while
  // the text is maximally scrambled, so the reflow lands under cover.
  const GLITCH_SETS = ['ss01', 'ss02', 'ss03', 'ss04', 'ss05'];
  const DWELL_MS = 4000;
  const GLITCH_MS = 400;
  const FRAME_MS = 55;

  const rotator = document.querySelector<HTMLElement>('.rotator');
  const live = document.querySelector<HTMLElement>('#greeting [data-live]');
  const pause = document.querySelector<HTMLButtonElement>('.zm-intro-pause');
  const words: string[] = JSON.parse(rotator?.dataset.words ?? '[]');

  // Shuffle every word after the first (Fisher-Yates). words[0] is already
  // on screen, so it stays put and the rest cycle in a random order.
  for (let i = words.length - 1; i > 1; i--) {
    const j = 1 + Math.floor(Math.random() * i);
    [words[i], words[j]] = [words[j], words[i]];
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (rotator && words.length > 1) {
    let index = 0;
    let onScreen = true;
    let paused = false;
    let timer: number | undefined;

    const letters = () => [...rotator.children] as HTMLElement[];

    const render = (word: string) => {
      rotator.replaceChildren(
        ...[...word].map((char) => {
          const span = document.createElement('span');
          span.className = 'letter';
          span.setAttribute('aria-hidden', 'true');
          span.textContent = char;
          return span;
        }),
      );
    };

    // Scramble most letters, leave a few alone — a uniform swap reads as a
    // second font rather than as breakage.
    const scramble = () => {
      for (const letter of letters()) {
        const set = GLITCH_SETS[Math.floor(Math.random() * GLITCH_SETS.length)];
        letter.style.fontFeatureSettings =
          Math.random() < 0.7 ? `'${set}' 1` : '';
      }
    };

    const settle = () => {
      for (const letter of letters()) letter.style.fontFeatureSettings = '';
    };

    const advance = () => {
      const started = performance.now();
      let swapped = false;

      const step = () => {
        const elapsed = performance.now() - started;

        if (elapsed >= GLITCH_MS) {
          settle();
          schedule(DWELL_MS);
          return;
        }

        if (!swapped && elapsed >= GLITCH_MS / 2) {
          index = (index + 1) % words.length;
          render(words[index]);
          if (live) live.textContent = `I make ${words[index]}`;
          swapped = true;
        }

        scramble();
        timer = window.setTimeout(step, FRAME_MS);
      };

      step();
    };

    const schedule = (delay: number) => {
      window.clearTimeout(timer);
      if (!onScreen || document.hidden || reduced.matches || paused) return;
      timer = window.setTimeout(advance, delay);
    };

    const stop = () => {
      window.clearTimeout(timer);
      settle();
    };

    const sync = () => {
      if (onScreen && !document.hidden && !reduced.matches && !paused) {
        schedule(DWELL_MS);
      } else {
        stop();
      }
    };

    // Don't animate in the corner of someone's eye while they read the page.
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(rotator);

    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);

    // WCAG 2.2.2: anything that moves for more than five seconds needs a
    // way to stop it. The button only appears when the words actually cycle.
    if (pause) {
      pause.hidden = false;
      pause.addEventListener('click', () => {
        paused = !paused;
        pause.setAttribute('aria-pressed', String(paused));
        pause.setAttribute(
          'aria-label',
          paused ? 'Play the rotating words' : 'Pause the rotating words',
        );
        pause.querySelector('i')?.classList.toggle('ph-pause', !paused);
        pause.querySelector('i')?.classList.toggle('ph-play', paused);
        sync();
      });
    }
  }
</script>

<style>
  .zm-intro {
    --avatarSize: min(8vw, 180px);
    font-family: var(--font-headings);
    font-variation-settings:
      'wght' 900,
      'wdth' 75,
      'ital' 0;
    font-size: var(--step-6);
    line-height: 0.9;
    color: var(--colour-text-bright);

    .letter:hover {
      font-feature-settings: 'ss03' 1;
    }

    .name {
      font-feature-settings:
        'wght' 900,
        'wdth' 125,
        'ital' 10;
      color: var(--colour-accent);
      position: relative;
      white-space: pre;

      img {
        transition: all 150ms ease-in-out;
        position: absolute;
        right: 0;
        bottom: 80%;
        width: var(--avatarSize);
        border-radius: 50%;
        aspect-ratio: 1 / 1;
        max-width: 180px;
      }
    }
    @media screen and (min-width: 500px) {
      font-size: var(--step-7);
    }
    @media screen and (min-width: 750px) {
      text-align: center;
    }
  }

  .zm-greeting {
    position: relative;
  }

  .zm-intro-pause {
    position: absolute;
    inset-block-end: -1.5em;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: none;
    color: var(--colour-text);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    opacity: 0.6;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      opacity: 1;
      border-color: currentcolor;
    }
  }
</style>
