---
// The pill fixed to the bottom of every page. BaseLayout renders it, so every
// page gets the flavour switch (website, desktop, terminal, plain text); pages
// that pass a slug also get hearts and reads, kept by /api/reactions, and
// blog posts and notes get marks (highlights) too.
//
// The pill talks: a short line pops up above whichever part you touch, a new
// one for every heart you give and a hint when you hover.
//
// Select text inside [data-highlightable] to mark it. Marks are drawn with the
// CSS Custom Highlight API, so the page's DOM is never changed: yours get a
// fill, other readers' a dotted underline. Hover one to see where and when it
// was made.
//
// It starts `hidden`, and the script unhides it in classic mode only, like
// HeadingMinimap. In plain text mode BaseLayout's inline script shows the
// flavour list on its own, unstyled. It brings its own CSS and SVG icons, so
// it also works on the pages that skip BaseLayout (/moons, /lil-debugger).
// Styles: src/styles/components/reactions.css.
import appWindowIcon from '~/assets/icons/reactions/app-window.svg?raw';
import browserIcon from '~/assets/icons/reactions/browser.svg?raw';
import heartIcon from '~/assets/icons/reactions/heart-fill.svg?raw';
import highlighterIcon from '~/assets/icons/reactions/highlighter.svg?raw';
import terminalIcon from '~/assets/icons/reactions/terminal-window.svg?raw';
import textIcon from '~/assets/icons/reactions/text-aa.svg?raw';
import { modeUrl } from '~/utils/uiMode';
import '../styles/components/reactions.css';

interface Props {
  /** The page path, e.g. /blog/my-post. Without one: the flavour switch only. */
  slug?: string;
  /** Marks (highlights) as well as hearts and reads. */
  highlights?: boolean;
  /** The flavour switch. Off on pages that skip BaseLayout. */
  flavours?: boolean;
}

const { slug, highlights = true, flavours = true } = Astro.props;
const marks = Boolean(slug) && highlights;
const icon = (svg: string) => svg.replace('<svg ', '<svg aria-hidden="true" ');

// Same page, other front end. See src/utils/uiMode.ts.
const here = Astro.url.pathname;
const flavourList = [
  {
    mode: 'classic',
    label: 'Website',
    icon: browserIcon,
    blurb: 'The ordinary site',
  },
  {
    mode: 'desktop',
    label: 'Desktop',
    icon: appWindowIcon,
    blurb: 'Windows and a menu bar, like an old Mac',
  },
  {
    mode: 'tui',
    label: 'Terminal',
    icon: terminalIcon,
    blurb: 'Keyboard only: arrows, Enter, Esc',
  },
  {
    mode: 'txt',
    label: 'Plain text',
    icon: textIcon,
    blurb: 'No styles at all, just the browser',
  },
] as const;
---

{
  (slug || flavours) && (
    <div class="reactions" data-slug={slug} hidden>
      <p class="visually-hidden" aria-live="polite" data-live />

      <div class="reactions-dock">
        <p class="reactions-say" aria-hidden="true" hidden />
        <div class="reactions-pill">
          {slug && (
            <>
              <button
                type="button"
                class="reactions-seg reactions-heart"
                aria-pressed="false"
                data-hint="leave a heart"
              >
                <Fragment set:html={icon(heartIcon)} />
                <span data-count="hearts">0</span>
                <span class="visually-hidden">hearts. Add a heart</span>
              </button>
              {marks && (
                <button
                  type="button"
                  class="reactions-seg"
                  popovertarget="reactions-panel"
                  data-hint="see what people marked"
                >
                  <Fragment set:html={icon(highlighterIcon)} />
                  <span>
                    <span data-count="highlights">0</span>{' '}
                    <span class="reactions-word" data-word="mark">marks</span>
                  </span>
                </button>
              )}
              <span class="reactions-seg" data-hint="" data-reads>
                <span data-count="views">0</span>{' '}
                <span class="reactions-word" data-word="read">reads</span>
              </span>
            </>
          )}
          {flavours && (
            <button
              type="button"
              class="reactions-seg reactions-flavour"
              popovertarget="reactions-flavours"
              data-hint="this site comes in four flavours"
            >
              <Fragment set:html={icon(browserIcon)} />
              <span class="visually-hidden">Change how this site looks</span>
            </button>
          )}
        </div>
      </div>

      {flavours && (
        <nav
          id="reactions-flavours"
          class="reactions-flavours"
          popover
          aria-label="Site flavours"
        >
          <p class="reactions-flavours-title">Four flavours, same site</p>
          <ul>
            {flavourList.map((f) => (
              <li>
                <a
                  href={modeUrl(f.mode, here)}
                  data-mode={f.mode}
                  aria-current={f.mode === 'classic' ? 'page' : undefined}
                >
                  <Fragment set:html={icon(f.icon)} />
                  <span>
                    <strong>{f.label}</strong>
                    <span data-blurb={f.blurb}>
                      {f.mode === 'classic' ? 'You are here' : f.blurb}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {marks && (
        <>
          <div id="reactions-panel" class="reactions-panel" popover>
            <header>
              <h2>Marked passages</h2>
              <div class="reactions-filter" role="group" aria-label="Show">
                <button type="button" data-show="all" aria-pressed="true">
                  All <span data-count="all">0</span>
                </button>
                <button type="button" data-show="mine" aria-pressed="false">
                  Yours <span data-count="mine">0</span>
                </button>
                <button type="button" data-show="them" aria-pressed="false">
                  Others <span data-count="them">0</span>
                </button>
              </div>
            </header>
            <ol />
            <p class="reactions-foot" />
          </div>

          <button type="button" class="reactions-add" hidden>
            Highlight
          </button>
          <div class="reactions-tip" role="tooltip" hidden />
        </>
      )}
    </div>
  )
}

<script>
  import trash from '~/assets/icons/reactions/trash.svg?raw';
  import {
    ago,
    type Highlight as Entry,
    flag,
    MAX_HEARTS,
    MAX_TEXT,
    place,
    plural,
    type Reactions,
  } from '~/utils/reactions';
  import { uiMode } from '~/utils/uiMode';

  // One line per heart given, then a last thanks once all ten are in.
  const THANKS = [
    'thank you',
    'oh, twice?',
    "you're too kind",
    'steady on',
    'halfway to ten',
    'you really like this one',
    "I'm blushing",
    'nearly there',
    'one more…',
    'ten! you legend',
  ];

  const box = document.querySelector<HTMLElement>('.reactions');

  if (box && uiMode() === 'classic') {
    box.hidden = false;

    const say = box.querySelector<HTMLElement>('.reactions-say')!;
    const live = box.querySelector<HTMLElement>('[data-live]')!;
    let holdUntil = 0;

    // Show a line above a segment. Heart lines stay put for a moment, so a
    // stray pointer move doesn't swap them for a hint.
    const show = (seg: HTMLElement, text: string, hold = false) => {
      if (!text || (!hold && Date.now() < holdUntil)) return;
      if (hold) holdUntil = Date.now() + 1800;
      const pill = seg.parentElement!.getBoundingClientRect();
      const rect = seg.getBoundingClientRect();
      say.style.setProperty('--x', `${rect.left - pill.left + rect.width / 2}px`);
      say.textContent = text;
      say.hidden = false;
      // restart the pop, so every heart gets one
      say.classList.remove('reactions-pop');
      void say.offsetWidth;
      say.classList.add('reactions-pop');
    };
    const hide = () => {
      const wait = holdUntil - Date.now();
      if (wait > 0) setTimeout(hide, wait);
      else say.hidden = true;
    };

    for (const seg of box.querySelectorAll<HTMLElement>('[data-hint]')) {
      seg.addEventListener('pointerenter', () => show(seg, seg.dataset.hint!));
      seg.addEventListener('pointerleave', hide);
    }

    if (box.dataset.slug) reactions(box, box.dataset.slug, show, hide, live);
  }

  function reactions(
    box: HTMLElement,
    slug: string,
    show: (seg: HTMLElement, text: string, hold?: boolean) => void,
    hide: () => void,
    live: HTMLElement,
  ) {
    const panel = box.querySelector<HTMLElement>('.reactions-panel');
    const list = panel?.querySelector('ol');
    const foot = panel?.querySelector<HTMLElement>('.reactions-foot');
    const root = panel && document.querySelector<HTMLElement>('[data-highlightable]');
    const heart = box.querySelector<HTMLButtonElement>('.reactions-heart')!;
    const reads = box.querySelector<HTMLElement>('[data-reads]')!;
    const add = box.querySelector<HTMLButtonElement>('.reactions-add');
    const tip = box.querySelector<HTMLElement>('.reactions-tip');
    const filters = [...box.querySelectorAll<HTMLButtonElement>('[data-show]')];
    const canDraw = 'highlights' in CSS;
    const compact = new Intl.NumberFormat('en', { notation: 'compact' });
    const number = new Intl.NumberFormat('en-GB');
    const when = new Intl.DateTimeFormat(undefined, {
      dateStyle: 'medium',
      timeStyle: 'short',
    });

    // A random id per browser. Without storage it lasts for this page load.
    let visitor: string = crypto.randomUUID();
    try {
      const saved = localStorage.getItem('reactions-visitor');
      if (saved) visitor = saved;
      else localStorage.setItem('reactions-visitor', visitor);
    } catch {}

    // Open any page with #admin=<REACTIONS_ADMIN_TOKEN> to delete anyone's
    // marks from then on; #admin= forgets it. A fragment never reaches the
    // server logs.
    let token = '';
    try {
      const fromHash = location.hash.match(/^#admin=(.*)$/);
      if (fromHash) {
        localStorage.setItem('reactions-admin', fromHash[1]);
        history.replaceState(null, '', location.pathname + location.search);
      }
      token = localStorage.getItem('reactions-admin') ?? '';
    } catch {}

    let data: Reactions = {
      views: 0,
      hearts: 0,
      myHearts: 0,
      highlights: [],
      admin: false,
    };
    let filter = 'all';
    let drawn: { h: Entry; range: Range }[] = [];
    let pending: { text: string; start: number; range: Range } | undefined;

    const send = async (body: Record<string, unknown>) => {
      const res = await fetch('/api/reactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, visitor, token, ...body }),
      });
      if (res.ok) render(await res.json());
    };

    // The text nodes of root as one string: offsets in it are what we store.
    // A start exactly at the end of a text node belongs to the next one.
    const rangeAt = (start: number, end: number) => {
      const walker = document.createTreeWalker(root!, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      let pos = 0;
      let started = false;
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const len = (node as Text).length;
        if (!started && start < pos + len) {
          range.setStart(node, start - pos);
          started = true;
        }
        if (started && end <= pos + len) {
          range.setEnd(node, end - pos);
          return range;
        }
        pos += len;
      }
    };

    // Ranges for each mark. If the page was edited since, look for the text
    // anywhere; if it is gone, the mark is only in the list.
    const locate = () => {
      const full = root?.textContent ?? '';
      drawn = data.highlights.flatMap((h) => {
        const at = full.startsWith(h.text, h.start) ? h.start : full.indexOf(h.text);
        const range = at < 0 ? undefined : rangeAt(at, at + h.text.length);
        return range ? [{ h, range }] : [];
      });
    };

    const visible = (h: Entry) =>
      filter === 'all' || (filter === 'mine') === h.mine;

    const draw = () => {
      if (!canDraw) return;
      for (const kind of ['mine', 'them'] as const) {
        const ranges = drawn
          .filter(({ h }) => visible(h) && h.mine === (kind === 'mine'))
          .map(({ range }) => range);
        CSS.highlights.set(`reactions-${kind}`, new Highlight(...ranges));
      }
    };

    const describe = (h: Entry) => {
      const from = place(h.city, h.country);
      const who = h.mine ? 'you' : `someone${from ? ` from ${from}` : ''}`;
      return `Highlighted by ${who} on ${when.format(h.createdAt * 1000)}.`;
    };

    const goTo = (id: number) => {
      const found = drawn.find(({ h }) => h.id === id);
      if (!found) return;
      panel?.hidePopover();
      const top = found.range.getBoundingClientRect().top;
      window.scrollBy({ top: top - window.innerHeight / 3 });
      if (!canDraw) return;
      CSS.highlights.set('reactions-flash', new Highlight(found.range));
      setTimeout(() => CSS.highlights.delete('reactions-flash'), 1500);
    };

    const renderList = () => {
      if (!list || !foot) return;
      const items = data.highlights.filter(visible).map((h) => {
        const li = document.createElement('li');
        if (h.mine) li.dataset.mine = '';
        const button = document.createElement('button');
        button.type = 'button';
        button.title = describe(h);
        button.disabled = !drawn.some((d) => d.h.id === h.id);
        button.addEventListener('click', () => goTo(h.id));
        const quote = document.createElement('q');
        quote.textContent = h.text.replace(/\s+/g, ' ');
        const who = document.createElement('span');
        who.className = 'reactions-who';
        const from = place(h.city, h.country);
        who.textContent = `${
          h.mine ? 'you' : [flag(h.country), from || 'someone'].filter(Boolean).join(' ')
        } · ${ago(h.createdAt)}`;
        button.appendChild(quote);
        button.appendChild(who);
        li.appendChild(button);
        if (h.mine || data.admin) {
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'reactions-delete';
          remove.innerHTML = trash.replace('<svg ', '<svg aria-hidden="true" ');
          remove.setAttribute('aria-label', 'Delete this mark');
          remove.title = 'Delete';
          remove.addEventListener('click', () => send({ action: 'delete', id: h.id }));
          li.appendChild(remove);
        }
        return li;
      });
      list.replaceChildren(...items);
      foot.textContent = data.highlights.length
        ? 'Select any sentence on the page to mark it.'
        : 'Nothing marked yet. Select any sentence to be the first.';
    };

    const setCount = (name: string, n: number) => {
      const el = box.querySelector(`[data-count="${name}"]`);
      if (el) el.textContent = compact.format(n);
    };

    // "1 mark", "6 marks": the word after a count follows it.
    const setWord = (word: string, n: number) => {
      const el = box.querySelector(`[data-word="${word}"]`);
      if (el) el.textContent = plural(n, word, `${word}s`);
    };

    function render(next: Reactions) {
      data = next;
      const mine = data.highlights.filter((h) => h.mine).length;
      setCount('hearts', data.hearts);
      setCount('views', data.views);
      setCount('highlights', data.highlights.length);
      setCount('all', data.highlights.length);
      setCount('mine', mine);
      setCount('them', data.highlights.length - mine);
      setWord('mark', data.highlights.length);
      setWord('read', data.views);
      heart.setAttribute('aria-pressed', String(data.myHearts > 0));
      heart.dataset.hint =
        data.myHearts >= MAX_HEARTS
          ? 'all ten given'
          : data.myHearts
            ? `${data.myHearts} given, ${MAX_HEARTS - data.myHearts} left`
            : 'leave a heart';
      reads.dataset.hint = `read by ${number.format(data.views)} ${plural(
        data.views,
        'person',
        'people',
      )}`;
      locate();
      draw();
      renderList();
    }

    heart.addEventListener('click', () => {
      if (data.myHearts >= MAX_HEARTS) {
        show(heart, 'all ten given. thank you', true);
        hide();
        return;
      }
      // Count it now; the reply has the real number.
      const line = THANKS[data.myHearts];
      render({ ...data, hearts: data.hearts + 1, myHearts: data.myHearts + 1 });
      show(heart, line, true);
      live.textContent = line;
      hide();
      send({ action: 'heart' });
    });

    for (const button of filters) {
      button.addEventListener('click', () => {
        filter = button.dataset.show!;
        for (const b of filters) b.setAttribute('aria-pressed', String(b === button));
        draw();
        renderList();
      });
    }

    if (root && add && tip) {
      // Show the Highlight button above a selection inside root.
      document.addEventListener('selectionchange', () => {
        const selection = document.getSelection();
        const range = selection?.rangeCount ? selection.getRangeAt(0) : undefined;
        const raw = range?.toString() ?? '';
        const text = raw.trim();
        if (
          !range ||
          !text ||
          text.length > MAX_TEXT ||
          !root.contains(range.commonAncestorContainer)
        ) {
          pending = undefined;
          add.hidden = true;
          return;
        }
        const before = document.createRange();
        before.setStart(root, 0);
        before.setEnd(range.startContainer, range.startOffset);
        const lead = raw.length - raw.trimStart().length;
        pending = { text, start: before.toString().length + lead, range };
        placeAdd();
        add.hidden = false;
      });

      const placeAdd = () => {
        if (!pending) return;
        const rect = pending.range.getBoundingClientRect();
        add.style.setProperty('--x', `${rect.left + rect.width / 2}px`);
        add.style.setProperty('--y', `${rect.top}px`);
      };

      // Keep the selection when the button is pressed.
      add.addEventListener('mousedown', (event) => event.preventDefault());
      add.addEventListener('click', () => {
        if (!pending) return;
        send({ action: 'highlight', text: pending.text, start: pending.start });
        document.getSelection()?.removeAllRanges();
      });

      // The marks aren't elements, so find the one under the pointer.
      let frame = 0;
      root.addEventListener('pointermove', ({ clientX: x, clientY: y }) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const hit = drawn.find(
            ({ h, range }) =>
              visible(h) &&
              [...range.getClientRects()].some(
                (r) => x >= r.left && x <= r.right && y >= r.top && y <= r.bottom,
              ),
          );
          tip.hidden = !hit;
          if (!hit) return;
          tip.textContent = describe(hit.h);
          tip.style.setProperty('--x', `${x}px`);
          tip.style.setProperty('--y', `${y}px`);
        });
      });
      root.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        tip.hidden = true;
      });
      window.addEventListener(
        'scroll',
        () => {
          tip.hidden = true;
          placeAdd();
        },
        { passive: true },
      );
    }

    send({ action: 'view' });
  }
</script>
