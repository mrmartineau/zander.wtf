---
// The pill fixed to the bottom of every page: the astro-d1-reactions pill
// (hearts, reads, and marks on blog posts and notes) plus this site's flavour
// switch (website, desktop, terminal, plain text). BaseLayout renders it, so
// every page gets the flavour switch; pages that pass a slug also get hearts
// and reads.
//
// The pill only shows in classic mode (`when`). In plain text mode
// BaseLayout's inline script shows the flavour list on its own, unstyled. It
// imports its own CSS and icons, so it also works on the pages that skip
// BaseLayout (/moons, /lil-debugger). Styles: src/styles/components/reactions.css.
import { Reactions as Pill } from 'astro-d1-reactions/components';
import appWindowIcon from '~/assets/icons/reactions/app-window.svg?raw';
import browserIcon from '~/assets/icons/reactions/browser.svg?raw';
import terminalIcon from '~/assets/icons/reactions/terminal-window.svg?raw';
import textIcon from '~/assets/icons/reactions/text-aa.svg?raw';
import { modeUrl } from '~/utils/uiMode';
import '../styles/components/reactions.css';

interface Props {
  /** The page path, e.g. /blog/my-post. Without one: the flavour switch only. */
  slug?: string;
  /** Marks (highlights) as well as hearts and reads. */
  highlights?: boolean;
  /** The flavour switch. Off on pages that skip BaseLayout. */
  flavours?: boolean;
}

const { slug, highlights = true, flavours = true } = Astro.props;
const icon = (svg: string) => svg.replace('<svg ', '<svg aria-hidden="true" ');

// Same page, other front end. See src/utils/uiMode.ts.
const here = Astro.url.pathname;
const flavourList = [
  {
    mode: 'classic',
    label: 'Website',
    icon: browserIcon,
    blurb: 'The ordinary site',
  },
  {
    mode: 'desktop',
    label: 'Desktop',
    icon: appWindowIcon,
    blurb: 'Windows and a menu bar, like an old Mac',
  },
  {
    mode: 'tui',
    label: 'Terminal',
    icon: terminalIcon,
    blurb: 'Keyboard only: arrows, Enter, Esc',
  },
  {
    mode: 'txt',
    label: 'Plain text',
    icon: textIcon,
    blurb: 'No styles at all, just the browser',
  },
] as const;
---
<Pill slug={slug ?? false} highlights={highlights} when="html.classic">
  {flavours && (
    <button
      type="button"
      class="reactions-seg reactions-flavour"
      popovertarget="reactions-flavours"
      data-hint="this site comes in four flavours"
    >
      <Fragment set:html={icon(browserIcon)} />
      <span class="visually-hidden">Change how this site looks</span>
    </button>
  )}
  {flavours && (
    <nav
      slot="after"
      id="reactions-flavours"
      class="reactions-flavours reactions-popover"
      popover
      aria-label="Site flavours"
    >
      <p class="reactions-flavours-title">Four flavours, same site</p>
      <ul>
        {flavourList.map((f) => (
          <li>
            <a
              href={modeUrl(f.mode, here)}
              data-mode={f.mode}
              aria-current={f.mode === 'classic' ? 'page' : undefined}
            >
              <Fragment set:html={icon(f.icon)} />
              <span>
                <strong>{f.label}</strong>
                <span data-blurb={f.blurb}>
                  {f.mode === 'classic' ? 'You are here' : f.blurb}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Pill>
