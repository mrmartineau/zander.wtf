---
// Single-key shortcuts. A key lives on its link as `aria-keyshortcuts` (header
// and footer, from `key` in consts.ts); pressing it follows that link, so this
// file holds no list of its own. "/" focuses search, "?" opens this dialog.
// Classic mode only: the desktop and terminal have their own keys.
import {
  Button,
  Dialog,
  DialogBody,
  DialogHeader,
  DialogTitle,
  Kbd,
} from '@mrmartineau/zui/astro';
import { SITE_FOOTER_ITEMS, SITE_NAV_ITEMS } from '../consts';

const shortcuts = [
  { text: 'Home', url: '/', key: 'h' },
  ...[...SITE_NAV_ITEMS, ...SITE_FOOTER_ITEMS].flatMap(({ text, url, key }) =>
    key ? [{ text, url, key }] : [],
  ),
  { text: 'Search', url: '/search', key: '/' },
];
---

<Dialog id="shortcuts" aria-labelledby="shortcuts-title">
  <form method="dialog">
    <Button class="zui-dialog-close" variant="ghost" size="sm" icon aria-label="Close">
      <i class="ph ph-x" aria-hidden="true"></i>
    </Button>
  </form>
  <DialogHeader>
    <DialogTitle id="shortcuts-title">Keyboard shortcuts</DialogTitle>
  </DialogHeader>
  <DialogBody>
    <p class="zui-text--2 mb-2">Tap these keys to navigate to the appropriate page.</p>
    <ul class="shortcuts-list">
      {
        shortcuts.map(({ text, url, key }) => (
          <li>
            <Kbd>{key.toUpperCase()}</Kbd>
            <a href={url}>{text}</a>
          </li>
        ))
      }
      <li><Kbd>?</Kbd> This list</li>
    </ul>
  </DialogBody>
</Dialog>

<style>
  .shortcuts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step--2);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  p {
    font-size: var(--step--2);
  }
</style>

<style is:global>
  /* Tailwind's preflight and the site's h2 are unlayered, so they beat ZUI's */
  #shortcuts {
    padding: var(--zui-dialog-padding);
  }

  #shortcuts .zui-dialog-title {
    margin: 0;
    font-size: var(--step-1);
  }

  /* Tooltip on every link that has a shortcut. Only where a keyboard is likely */
  @media (hover: hover) {
    a[aria-keyshortcuts] {
      position: relative;

      &::after {
        opacity: 0;
        visibility: hidden;
        content: 'Press ' attr(aria-keyshortcuts) / '';
        /* Screen readers get aria-keyshortcuts itself, so hide this text from them */
        position: absolute;
        top: 100%;
        left: 50%;
        translate: -50% 0;
        transition: opacity 200ms ease;
      }
    }

    a[aria-keyshortcuts]:is(:hover, :focus-visible)::after {
      opacity: 1;
      visibility: visible;
      margin-top: var(--space-3xs);
      padding: var(--space-3xs) var(--space-2xs);
      border-radius: var(--radius-md);
      background-color: var(--color-surface);
      box-shadow: var(--shadow-md);
      color: var(--color-text);
      font-size: var(--step--3);
      font-family: var(--font-mono);
      line-height: 1.2;
      font-variation-settings: normal;
      letter-spacing: normal;
      text-transform: capitalize;
      white-space: nowrap;
      pointer-events: none;
      z-index: 1;
    }
  }
</style>

<script>
  import { uiMode } from '~/utils/uiMode';

  function isFormField(element: EventTarget | null) {
    if (!(element instanceof HTMLElement)) {
      return false;
    }

    const name = element.nodeName.toLowerCase();
    const type = (element.getAttribute('type') || '').toLowerCase();
    return (
      name === 'select' ||
      name === 'textarea' ||
      (name === 'input' && type !== 'submit' && type !== 'reset') ||
      element.isContentEditable
    );
  }

  const dialog = document.getElementById('shortcuts') as HTMLDialogElement;

  document.addEventListener('keydown', (event) => {
    if (
      uiMode() !== 'classic' ||
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      event.repeat ||
      event.isComposing ||
      isFormField(event.target)
    ) {
      return;
    }

    if (event.key === '?') {
      event.preventDefault();
      if (dialog.open) {
        dialog.close();
      } else {
        dialog.showModal();
      }
      return;
    }

    // Focus the search input if the page has one, otherwise go to the search page
    if (event.key === '/') {
      event.preventDefault();
      dialog.close();
      const input = document.querySelector<HTMLInputElement>('.search-input');
      if (input) {
        input.focus();
      } else {
        window.location.assign('/search');
      }
      return;
    }

    if (!/^[a-z]$/i.test(event.key)) {
      return;
    }
    const link = document.querySelector<HTMLAnchorElement>(
      `a[aria-keyshortcuts="${event.key.toLowerCase()}"]`,
    );
    if (link) {
      event.preventDefault();
      link.click();
    }
  });
</script>
