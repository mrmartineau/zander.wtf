---
import { getCollection } from 'astro:content';
import ProjectRow from './ProjectRow.astro';
import ProjectSpotlight from './ProjectSpotlight.astro';

// The newest promoted project gets the spotlight; the rest are listed beside it.
const [newest, ...rest] = (await getCollection('projects'))
  .filter((project) => project.data?.promote)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

{
  newest ? (
    <div class="zm-promoted">
      <ProjectSpotlight project={newest} label="New" />
      <aside class="zm-promoted-rest">
        <h4>Also building</h4>
        <ul>
          {rest.map((project) => (
            <li>
              <ProjectRow project={project} />
            </li>
          ))}
        </ul>
        <a href="/projects" class="zm-promoted-all">
          View all projects →
        </a>
      </aside>
    </div>
  ) : null
}

<style>
  .zm-promoted {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);

    @media (min-width: 1100px) {
      grid-template-columns: 2fr 1fr;
    }
  }

  .zm-promoted-rest {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: 2rem;
    background: var(--bg-block);

    h4 {
      font-size: var(--step-0);
      color: var(--colour-text-bright);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      list-style: none;
      padding: 0;
      margin: 0;
    }
  }

  .zm-promoted-all {
    margin-block-start: auto;
    font-size: var(--step--1);
  }
</style>
