---
// Shown on the classic home page only: the other two ways to view the site.
---

<section class="zm-modes" aria-label="Other ways to view this site">
  <p class="zm-modes-title">This site comes in three flavours.</p>
  <div class="zm-modes-options">
    <button type="button" class="zm-mode" data-mode="desktop">
      <i class="ph-duotone ph-app-window" aria-hidden="true"></i>
      <span>
        <strong>Desktop mode</strong>
        Windows, a menu bar and Spotlight, like an old Mac.
      </span>
    </button>
    <button type="button" class="zm-mode" data-mode="tui">
      <i class="ph-duotone ph-terminal-window" aria-hidden="true"></i>
      <span>
        <strong>Terminal mode</strong>
        Keyboard only. Arrow keys, Enter and Esc.
      </span>
    </button>
  </div>
</section>

<script>
  import { setUiMode, type UiMode } from '~/utils/uiMode';

  for (const button of document.querySelectorAll<HTMLButtonElement>('.zm-mode')) {
    button.addEventListener('click', () =>
      setUiMode(button.dataset.mode as UiMode),
    );
  }
</script>

<style>
  .zm-modes {
    margin-block: var(--space-l);
    border-block: 1px dashed var(--border);
    padding-block: var(--space-m);
  }

  .zm-modes-title {
    font-family: var(--font-headings);
    color: var(--colour-text-bright);
    margin-block-end: var(--space-s);
    text-align: center;
  }

  .zm-modes-options {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: 1fr;

    @media screen and (min-width: 700px) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .zm-mode {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--bg-block);
    color: var(--colour-text);
    border: 1px solid transparent;
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: border-color 150ms ease-in-out;

    &:hover {
      border-color: var(--colour-accent);
    }

    i {
      font-size: var(--step-4);
      color: var(--colour-accent);
      flex-shrink: 0;
    }

    strong {
      display: block;
      font-family: var(--font-headings);
      color: var(--colour-text-bright);
    }
  }
</style>
