---
// Shown on the website home page: the three ways to view this site. The
// current one is marked; the others are plain links (see src/utils/uiMode.ts).
const modes = [
  {
    label: 'Website',
    href: '/',
    icon: 'ph-browser',
    blurb: 'The ordinary site. You are here.',
    current: true,
  },
  {
    label: 'Desktop',
    href: '/desktop/',
    icon: 'ph-app-window',
    blurb: 'Windows, a menu bar and Spotlight, like an old Mac.',
  },
  {
    label: 'Terminal',
    href: '/tui/',
    icon: 'ph-terminal-window',
    blurb: 'Keyboard only. Arrow keys, Enter and Esc.',
  },
];
---

<section class="zm-modes" aria-label="Ways to view this site">
  <p class="zm-modes-title">This site comes in three flavours.</p>
  <div class="zm-modes-options">
    {
      modes.map((m) =>
        m.current ? (
          <div class="zm-mode is-current" aria-current="true">
            <i class={`ph-duotone ${m.icon}`} aria-hidden="true" />
            <span>
              <strong>{m.label}</strong>
              {m.blurb}
            </span>
          </div>
        ) : (
          <a class="zm-mode" href={m.href}>
            <i class={`ph-duotone ${m.icon}`} aria-hidden="true" />
            <span>
              <strong>{m.label}</strong>
              {m.blurb}
            </span>
          </a>
        ),
      )
    }
  </div>
</section>

<style>
  .zm-modes {
    padding-block: var(--space-m);
    border-block: 1px dashed var(--border);
  }

  .zm-modes-title {
    font-family: var(--font-headings);
    color: var(--colour-text-bright);
    margin-block-end: var(--space-s);
    text-align: center;
  }

  .zm-modes-options {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: 1fr;

    @media screen and (min-width: 700px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .zm-mode {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--bg-block);
    color: var(--colour-text);
    border: 1px solid transparent;
    text-align: left;
    transition: border-color 150ms ease-in-out;

    &:hover {
      border-color: var(--colour-accent);
    }

    &.is-current {
      border-color: var(--colour-accent);
      background-color: transparent;
    }

    i {
      font-size: var(--step-4);
      color: var(--colour-accent);
      flex-shrink: 0;
    }

    strong {
      display: block;
      font-family: var(--font-headings);
      color: var(--colour-text-bright);
    }
  }
</style>
