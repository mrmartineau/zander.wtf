---
// The three ways to view this site, shown on the website (home page and
// footer). The current one is marked; the others link to the same page in
// that front end (see src/utils/uiMode.ts).
const here = Astro.url.pathname;
const modes = [
  {
    label: 'Website',
    href: here,
    icon: 'ph-browser',
    blurb: 'The ordinary site. You are here.',
    current: true,
  },
  {
    label: 'Desktop',
    href: `/desktop${here === '/' ? '/' : here}`,
    icon: 'ph-app-window',
    blurb: 'Windows, a menu bar and Spotlight, like an old Mac.',
  },
  {
    label: 'Terminal',
    href: `/tui${here === '/' ? '/' : here}`,
    icon: 'ph-terminal-window',
    blurb: 'Keyboard only. Arrow keys, Enter and Esc.',
  },
  {
    label: 'Plain text',
    href: `/txt${here === '/' ? '/' : here}`,
    icon: 'ph-text-aa',
    blurb: 'No stylesheets. Just the browser defaults.',
  },
];
---

<section class="zm-modes" aria-label="Ways to view this site">
  <p class="zm-modes-title">This site comes in four flavours.</p>
  <div class="zm-modes-options">
    {
      modes.map((m) =>
        m.current ? (
          <div class="zm-mode is-current" aria-current="true">
            <i class={`ph-duotone ${m.icon}`} aria-hidden="true" />
            <div>
              <strong>{m.label}</strong>
              <span>{m.blurb}</span>
            </div>
          </div>
        ) : (
          <a class="zm-mode" href={m.href}>
            <i class={`ph-duotone ${m.icon}`} aria-hidden="true" />
            <span>
              <strong>{m.label}</strong>
              <span>{m.blurb}</span>
            </span>
          </a>
        ),
      )
    }
  </div>
</section>

<style>
  .zm-modes {
    padding-block: var(--space-m);
    border-block: 1px dashed var(--border);
  }

  .zm-modes-title {
    font-family: var(--font-headings);
    color: var(--colour-text-bright);
    margin-block-end: var(--space-s);
    text-align: center;
  }

  .zm-modes-options {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: 1fr;

    @media screen and (min-width: 700px) {
      grid-template-columns: repeat(2, 1fr);
    }
    @media screen and (min-width: 1100px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .zm-mode {
    display: flex;
    align-items: start;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--bg-block);
    color: var(--colour-text);
    border: 1px solid transparent;
    text-align: left;
    transition: border-color 150ms ease-in-out;

    &:hover {
      border-color: var(--colour-accent);
    }

    &.is-current {
      border-color: var(--colour-accent);
      background-color: transparent;
    }

    i {
      font-size: var(--step-2);
      color: var(--colour-accent);
      flex-shrink: 0;
    }

    strong {
      display: block;
      font-family: var(--font-headings);
      color: var(--colour-text-bright);
      font-size: var(--step--1);
    }

    span {
      font-family: var(--font-body);
      font-size: var(--step--2);
    }
  }
</style>
